# ─── APIForge Backend Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.
# Do NOT commit .env to Git.

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# AI Configuration (Option A: Gemini / Option B: OpenAI / Option C: Groq / Option D: Ollama)
# Get Gemini API key at: https://aistudio.google.com
OPENAI_API_KEY=your_ai_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.5-flash
