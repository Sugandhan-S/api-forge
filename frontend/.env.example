# ─── APIForge Frontend Environment Configuration ─────────────────────────────
# Copy this file to .env and fill in your values.

# Backend Express API URL
VITE_BACKEND_URL=http://localhost:3001

# Supabase Auth & Storage (Optional — falls back to Guest Mode + localStorage without this)
# Sign up at https://supabase.com and copy credentials from Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
